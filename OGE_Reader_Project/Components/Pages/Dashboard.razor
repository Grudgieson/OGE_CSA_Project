@page "/"
@inject IDialogService DialogService

<PageTitle>Dashboard</PageTitle>

<MudGrid Spacing="0" Justify="Justify.Center" style="display: flex;">
    <MudItem xs="6">
        <div Class="ml-20">

            <MudText Typo="Typo.h4"Class="mt-8 pb-4">Most Active User</MudText>
            <MudText Typo="Typo.h5"Class="ml-8">@FileStorage.mostActiveHashID</MudText>
            <MudText Typo="Typo.h6"Class="ml-8">@FileStorage.mostActiveHashIDScans Scans</MudText>

            <MudText Typo="Typo.h4"Class="mt-8 pb-4">Most Active Reader</MudText>
            <MudText Typo="Typo.h5"Class="ml-8">@FileStorage.mostActiveReader</MudText>
            <MudText Typo="Typo.h6"Class="ml-8">@FileStorage.mostActiveReaderEventCount Scans</MudText>

            <MudText Typo="Typo.h4"Class="mt-8 pb-4">Busiest Day of The Week</MudText>
            <MudText Typo="Typo.h5"Class="ml-8">@FileStorage.busiestDay</MudText>
            <MudText Typo="Typo.h6"Class="ml-8">@FileStorage.busiestDayAverageScans Average Scans</MudText>

            <MudText Typo="Typo.h4"Class="mt-8 pb-4">Average Unique Visitors Per Day</MudText>
            <MudText Typo="Typo.h5"Class="ml-8">Unique Visitors</MudText>
            <MudText Typo="Typo.h6"Class="ml-8">@FileStorage.averageUniqueVisitorsPerDay People</MudText>

        </div>
    </MudItem>

    <MudItem xs="6">
        <MudTable Class="mb-4" Style="width:800px" Items="@AlertSystem.masterAlertList" FixedHeader="true" Dense="true" Filter="new Func<AlertSystem.DataAlert,bool>(SearchFilterFunc)">
            <ToolBarContent>
                <MudTextField @bind-Value="tableSearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Settings" aria-label="Alert System Settings" OnClick="OpenDialogAsync"></MudIconButton>
            </ToolBarContent>
            <ColGroup>
                <col style="overflow-wrap; width: 20%;" />
                <col style="overflow-wrap;" />
                <col style="width: 15%;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Alert</MudTh>
                <MudTh>Description</MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<AlertSystem.DataAlert, object>(x=>x.alertSeverity)"></MudTableSortLabel>Severity</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Alert">@context.alertType</MudTd>
                <MudTd DataLabel="Description">@context.alertDescription</MudTd>
                <MudTd DataLabel="Severity"><MudAlert Severity="@context.alertSeverity" ContentAlignment="HorizontalAlignment.Center"></MudAlert></MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager
                    PageSizeOptions="new int[] {7}"
                    HideRowsPerPage="true"
                    HidePageNumber="true"
                    />
            </PagerContent>
        </MudTable>
    </MudItem>
</MudGrid>

<div class="ml-20">
    <MudText Typo="Typo.h6"Class="mt-8">Scan Activity Over (@FileStorage.chartFilter)</MudText>

    <div style="display: flex; justify-content: center;">
            <MudChart ChartType="ChartType.Line" ChartSeries="@FileStorage.Series" XAxisLabels="@FileStorage.XAxisLabels" Width="100%" Height="420px" ChartOptions="@FileStorage.Options" AxisChartOptions="@FileStorage.axisOptions"></MudChart>
	</div>

</div>

@code
{
    private async Task OpenDialogAsync()
    {

        // Save Initial Alert System Threashold Values so they can be restored if dialog is canceled
        int intialDupThreashold = AlertSystem.duplicateThreashold;
        int intialLowActivityThreashold = AlertSystem.lowUserActivityThreashold;
        int intialHighUsageThreashold = AlertSystem.numberOfScansForUsageAlert;

        var dialog = await DialogService.ShowAsync<Settings_Dialog>("Options Dialog");
        var result = await dialog.Result;

        if(!result.Canceled)
        {

            FileStorage.GetAlerts();

        }
        else
        {

            AlertSystem.duplicateThreashold = intialDupThreashold;
            AlertSystem.lowUserActivityThreashold = intialLowActivityThreashold;
            AlertSystem.numberOfScansForUsageAlert = intialHighUsageThreashold;

        }
    }

    private string tableSearchString = "";

    // Takes the string typed into the search bar of the alert system table and then compares it to the data to find a match or similar match
    private bool SearchFilterFunc(AlertSystem.DataAlert alertSearch) => FilterFunc(alertSearch, tableSearchString);
    private bool FilterFunc(AlertSystem.DataAlert alertSearching, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (alertSearching.alertType.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (alertSearching.alertDescription.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{alertSearching.alertType} {alertSearching.alertDescription}".Contains(searchString))
            return true;
        return false;
    }

}

